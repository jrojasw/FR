# Base de datos Postgres
DATABASE_URL="postgresql://usuario:password@localhost:5432/horas_extras?schema=public"

# Firma de las cookies de sesión (usa un valor largo y aleatorio en producción)
SESSION_SECRET="cambia-este-valor-por-uno-aleatorio-y-largo"

# Cuenta de Administradora (correo + clave). Se crea/actualiza sola cada vez
# que arranca el servidor (ver src/instrumentation.ts). Cambia la clave por
# una segura.
ADMIN_EMAIL="admin@ejemplo.cl"
ADMIN_PASSWORD="cambia-esta-clave"
ADMIN_NAME="Administradora"
