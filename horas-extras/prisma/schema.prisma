// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SOLICITANTE
  ADMIN
}

enum TipoRegistro {
  TURNO_DOMINGO
  HORAS_EXTRA
}

enum OvertimeStatus {
  PENDIENTE
  APROBADA
  RECHAZADA
}

model User {
  id        String   @id @default(cuid())
  name      String
  role      Role     @default(SOLICITANTE)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  // Colaboradora (SOLICITANTE): acceso con PIN fijo asignado por la Administradora.
  pinHash String?

  // Administradora (ADMIN): acceso con correo y clave.
  email        String? @unique
  passwordHash String?

  entries         OvertimeEntry[] @relation("EntryOwner")
  reviewedEntries OvertimeEntry[] @relation("EntryReviewer")
}

// Registro de un turno domingo (aseo) o de horas extra entre semana.
model OvertimeEntry {
  id          String       @id @default(cuid())
  correlativo Int          @unique @default(autoincrement())
  tipo        TipoRegistro

  fecha DateTime

  // Solo aplican a HORAS_EXTRA; TURNO_DOMINGO es una unidad completa sin horario.
  horaInicio DateTime?
  horaFin    DateTime?
  horas      Decimal?      @db.Decimal(5, 2)

  motivo String?

  status        OvertimeStatus @default(PENDIENTE)
  createdAt     DateTime       @default(now())
  reviewedAt    DateTime?
  reviewComment String?
  // La administradora marca esto al aprobar, tras confirmar que el registro
  // coincide con la marcación del reloj biométrico (la validación biométrica
  // ocurre en el reloj físico, fuera de esta app).
  validadoReloj Boolean        @default(false)

  user   User   @relation("EntryOwner", fields: [userId], references: [id])
  userId String

  reviewer   User?   @relation("EntryReviewer", fields: [reviewerId], references: [id])
  reviewerId String?

  @@index([userId])
  @@index([status])
}
