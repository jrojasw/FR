# Base de datos Postgres
DATABASE_URL="postgresql://usuario:password@localhost:5432/fondos_a_rendir?schema=public"

# Firma de las cookies de sesión (usa un valor largo y aleatorio en producción)
SESSION_SECRET="cambia-este-valor-por-uno-aleatorio-y-largo"

# Envío de correo (PIN de acceso y notificaciones). Sin esta variable, el
# PIN se muestra en pantalla y los correos quedan solo en el log del servidor.
RESEND_API_KEY=""
EMAIL_FROM="Fondos a Rendir <onboarding@resend.dev>"

# Roles fijos por correo
ADMIN_EMAIL="jorge.rojas@copayapunos.cl"
APPROVER_EMAIL="williams.arce@copayapunos.cl"

# URL pública de la app (para armar enlaces en los correos). Si se omite,
# se infiere del encabezado Host de cada request.
APP_URL=""

# Carpeta donde se guardan las fotos/documentos adjuntos (por defecto ./storage/attachments)
ATTACHMENTS_DIR=""
