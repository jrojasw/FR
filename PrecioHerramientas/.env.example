# Copiar a .env y completar. Nunca subir .env al repositorio.

POSTGRES_DB=precioherramientas
POSTGRES_USER=precio
POSTGRES_PASSWORD=cambiar-por-una-clave-larga

# Acceso al dashboard de Hangfire en /hangfire (HTTP Basic, usar solo con HTTPS)
HANGFIRE_USER=admin
HANGFIRE_PASSWORD=cambiar-por-otra-clave-larga

# Dominio público (solo si se levanta Caddy con --profile proxy)
DOMAIN=precios.midominio.cl

# Puerto local del contenedor web (enlazado a 127.0.0.1)
WEB_PORT=8080

# true = incluir Chromium en la imagen para tiendas que requieren navegador (Sodimac)
INSTALL_PLAYWRIGHT=true

# Tiendas habilitadas
SCRAPE_EASY=true
SCRAPE_SODIMAC=true
SCRAPE_IMPERIAL=false


SCRAPER_USER_AGENT=Mozilla/5.0 (compatible; PrecioHerramientasBot/1.0; +https://precios.midominio.cl/bot)
