@model ProductListItem
<div class="card h-100 product-card shadow-sm">
    <a asp-page="/Product" asp-route-slug="@Model.Slug" class="ratio ratio-1x1 bg-white border-bottom product-thumb">
        @if (!string.IsNullOrEmpty(Model.ImageUrl))
        {
            <img src="@Model.ImageUrl" alt="@Model.Name" loading="lazy" class="object-fit-contain p-2" referrerpolicy="no-referrer" />
        }
        else
        {
            <span class="d-flex align-items-center justify-content-center text-muted fs-1">🔧</span>
        }
    </a>
    <div class="card-body d-flex flex-column">
        @if (Model.BrandName is not null)
        {
            <div class="small text-uppercase text-muted fw-semibold">@Model.BrandName</div>
        }
        <a asp-page="/Product" asp-route-slug="@Model.Slug" class="stretched-link text-reset text-decoration-none product-name">@Model.Name</a>
        <div class="mt-auto pt-2">
            <div class="fs-5 fw-bold text-success">@Format.Price(Model.BestPrice)</div>
            <div class="small text-muted">
                @(Model.OfferCount == 1 ? "1 tienda" : $"{Model.OfferCount} tiendas")
            </div>
        </div>
    </div>
</div>
