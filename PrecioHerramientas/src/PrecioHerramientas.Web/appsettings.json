{
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=precioherramientas;Username=postgres;Password=postgres"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "System.Net.Http.HttpClient": "Warning",
      "Polly": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "MigrateOnStartup": true
  },
  "Hangfire": {
    "RunServer": true,
    "WorkerCount": 2,
    "DashboardPath": "/hangfire",
    "DashboardUser": "admin",
    "DashboardPassword": "",
    "TimeZone": "America/Santiago"
  },
  "Ingestion": {
    "BatchSize": 100,
    "MinCoverageToMarkUnavailable": 0.5
  },
  "Scrapers": {
    "UserAgent": "Mozilla/5.0 (compatible; PrecioHerramientasBot/1.0; +https://example.cl/bot)",
    "RequestTimeoutSeconds": 30,
    "Stores": {
      "easy": {
        "Enabled": true,
        "Cron": "15 */6 * * *",
        "DelayBetweenRequestsMs": 1500,
        "MaxPagesPerQuery": 10,
        "Queries": []
      },
      "sodimac": {
        "Enabled": false,
        "Cron": "40 3,15 * * *",
        "DelayBetweenRequestsMs": 4000,
        "MaxPagesPerQuery": 5,
        "UsePlaywright": true,
        "Queries": [],
        "Selectors": {}
      },
      "imperial": {
        "Enabled": false,
        "Cron": "25 */8 * * *",
        "DelayBetweenRequestsMs": 2000,
        "MaxPagesPerQuery": 10,
        "Queries": [],
        "Selectors": {}
      },
      "demo-norte": { "Enabled": false, "Cron": "0 * * * *", "DelayBetweenRequestsMs": 0 },
      "demo-sur": { "Enabled": false, "Cron": "30 * * * *", "DelayBetweenRequestsMs": 0 }
    }
  }
}
