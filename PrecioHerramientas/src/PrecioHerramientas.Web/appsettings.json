{
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=precioherramientas;Username=postgres;Password=postgres"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "System.Net.Http.HttpClient": "Warning",
      "Polly": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "MigrateOnStartup": true
  },
  "Hangfire": {
    "RunServer": true,
    "WorkerCount": 2,
    "DashboardPath": "/hangfire",
    "DashboardUser": "admin",
    "DashboardPassword": "",
    "TimeZone": "America/Santiago"
  },
  "Ingestion": {
    "BatchSize": 100,
    "MinCoverageToMarkUnavailable": 0.5
  },
  "Scrapers": {
    "UserAgent": "Mozilla/5.0 (compatible; PrecioHerramientasBot/1.0; +https://example.cl/bot)",
    "RequestTimeoutSeconds": 30,
    "Stores": {
      "easy": {
        "Enabled": true,
        "Cron": "15 */6 * * *",
        "DelayBetweenRequestsMs": 1500,
        "MaxPagesPerQuery": 10,
        "Queries": [
          "taladro",
          "rotomartillo",
          "esmeril angular",
          "atornillador",
          "sierra circular",
          "lijadora",
          "compresor",
          "hidrolavadora"
        ]
      },
      "sodimac": {
        "Enabled": true,
        "Cron": "40 3,15 * * *",
        "DelayBetweenRequestsMs": 4000,
        "MaxPagesPerQuery": 5,
        "SearchUrlTemplate": "/sodimac-cl/buscar?Ntt={query}&page={page}",
        "Queries": [
          "taladro",
          "rotomartillo",
          "esmeril angular",
          "atornillador",
          "sierra circular",
          "lijadora",
          "compresor",
          "hidrolavadora"
        ],
        "Selectors": {}
      },
      "imperial": {
        "Enabled": true,
        "Cron": "25 */8 * * *",
        "DelayBetweenRequestsMs": 2000,
        "MaxPagesPerQuery": 10,
        "Queries": [
          "taladro",
          "rotomartillo",
          "esmeril angular",
          "atornillador",
          "sierra circular",
          "lijadora",
          "compresor",
          "hidrolavadora"
        ],
        "Selectors": {}
      },
      "construmart": {
        "Enabled": true,
        "Cron": "35 5,17 * * *",
        "DelayBetweenRequestsMs": 3000,
        "MaxPagesPerQuery": 3,
        "Queries": [
          "taladro",
          "rotomartillo",
          "esmeril angular",
          "atornillador",
          "sierra circular",
          "lijadora",
          "compresor",
          "hidrolavadora"
        ],
        "Branches": {
          "Regions": [
            "Metropolitana"
          ],
          "List": [],
          "CookieName": null,
          "Selectors": {}
        },
        "Selectors": {}
      }
    }
  }
}
