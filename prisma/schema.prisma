// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SOLICITANTE
  APROBADOR
  ADMIN
}

enum ReportStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  PAID
}

enum DocumentType {
  BOLETA
  FACTURA
  RECIBO
}

enum AttachmentKind {
  PHOTO
  DOCUMENT
}

model User {
  id        String   @id @default(cuid())
  name      String?
  cargo     String?
  email     String   @unique
  role      Role     @default(SOLICITANTE)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  reports         ExpenseReport[] @relation("ReportOwner")
  reviewedReports ExpenseReport[] @relation("ReportReviewer")
  paidReports     ExpenseReport[] @relation("ReportPaidBy")
  otpCodes        OtpCode[]
}

// Código de un solo uso enviado por correo para iniciar sesión (passwordless)
model OtpCode {
  id         String    @id @default(cuid())
  email      String
  code       String
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())

  user   User?   @relation(fields: [userId], references: [id])
  userId String?

  @@index([email])
}

// Rendición de Fondos Fijos
model ExpenseReport {
  id          String @id @default(cuid())
  correlativo Int    @unique @default(autoincrement())

  nombre   String
  apellido String
  cargo    String
  fecha    DateTime

  // Totales calculados al enviar (se guardan como respaldo del registro).
  // El reembolso corresponde siempre al total rendido (suma de los documentos).
  totalRendido   Decimal @default(0) @db.Decimal(12, 2)
  montoReembolso Decimal @default(0) @db.Decimal(12, 2)

  rut           String?
  signatureData String? @db.Text

  // Si la rendición se hace a nombre de otra persona (no de quien la ingresa),
  // se guardan también los datos de esa persona.
  esParaOtraPersona    Boolean @default(false)
  beneficiarioNombre   String?
  beneficiarioApellido String?
  beneficiarioRut      String?
  beneficiarioEmail    String?

  status        ReportStatus @default(DRAFT)
  createdAt     DateTime     @default(now())
  submittedAt   DateTime?
  reviewedAt    DateTime?
  reviewComment String?

  user   User   @relation("ReportOwner", fields: [userId], references: [id])
  userId String

  reviewer   User?   @relation("ReportReviewer", fields: [reviewerId], references: [id])
  reviewerId String?

  // Certificado de pago del banco, sube el administrador cuando ya se pagó
  paymentCertificatePath String?
  paymentCertificateName String?
  paidAt                 DateTime?
  paidBy                 User?     @relation("ReportPaidBy", fields: [paidById], references: [id])
  paidById               String?

  // Último recordatorio automático de "falta subir comprobante de pago"
  // enviado mientras la rendición sigue Aprobada sin certificado.
  lastPaymentReminderAt DateTime?

  items       ExpenseItem[]
  attachments Attachment[]

  @@index([userId])
  @@index([status])
}

// Línea de detalle: Glosa / Proveedor / Tipo documento / N° documento / Monto Total
model ExpenseItem {
  id              String       @id @default(cuid())
  glosa           String
  proveedor       String
  tipoDocumento   DocumentType
  numeroDocumento String
  montoTotal      Decimal      @db.Decimal(12, 2)
  createdAt       DateTime     @default(now())

  report   ExpenseReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  reportId String

  @@index([reportId])
}

// Fotos de comprobantes o documentos digitales adjuntos a la rendición (máx. 25)
model Attachment {
  id        String         @id @default(cuid())
  fileName  String
  filePath  String
  mimeType  String
  size      Int
  kind      AttachmentKind
  createdAt DateTime       @default(now())

  report   ExpenseReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  reportId String

  @@index([reportId])
}
